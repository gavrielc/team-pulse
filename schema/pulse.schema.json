{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gavrielc/team-pulse/schema/pulse.schema.json",
  "title": "pulse.json",
  "type": "object",
  "required": ["members", "projects", "checkins"],
  "additionalProperties": false,
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["member", "project", "week", "mood"],
        "additionalProperties": false,
        "properties": {
          "member": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "week": {
            "type": "string",
            "pattern": "^\\d{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"
          },
          "mood": { "type": "integer", "minimum": 1, "maximum": 5 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
