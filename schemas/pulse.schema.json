{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gavrielc/team-pulse/schemas/pulse.schema.json",
  "title": "TeamPulse",
  "description": "Shape of pulse.json: the data the dashboard's tiles, member cards and weekly-trend chart are built from. Draft for T2 (API contract) to confirm or amend.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "repo", "summary", "members", "weekly_trend"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this snapshot was produced."
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "description": "GitHub owner/name this pulse was generated from."
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      },
      "required": ["from", "to"]
    },
    "summary": {
      "type": "object",
      "description": "Tile values.",
      "additionalProperties": false,
      "required": ["total_commits", "total_contributors", "total_prs_merged"],
      "properties": {
        "total_commits": { "type": "integer", "minimum": 0 },
        "total_contributors": { "type": "integer", "minimum": 0 },
        "total_prs_merged": { "type": "integer", "minimum": 0 },
        "total_lines_changed": { "type": "integer", "minimum": 0 }
      }
    },
    "members": {
      "type": "array",
      "description": "One entry per contributor; drives the member cards and the contributions-by-author chart.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "commits"],
        "properties": {
          "login": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "avatar_url": { "type": "string", "format": "uri" },
          "commits": { "type": "integer", "minimum": 0 },
          "prs_merged": { "type": "integer", "minimum": 0, "default": 0 },
          "last_active": { "type": "string", "format": "date-time" }
        }
      }
    },
    "weekly_trend": {
      "type": "array",
      "description": "One entry per week; drives the weekly-trend chart.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week_start", "commits"],
        "properties": {
          "week_start": { "type": "string", "format": "date" },
          "commits": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
